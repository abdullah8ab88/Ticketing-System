NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Optional: only for scripts/seed-admin.ts
FIREBASE_ADMIN_PROJECT_ID=your_project_id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxx@your_project.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
YOUR_KEY
-----END PRIVATE KEY-----
"
ADMIN_EMAIL=admin@lazem.sa
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Lazem Admin

# Public URL of the deployed app, used to build the "Open Ticket" link in emails
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: restrict "Sign in with Microsoft" to a single Azure AD tenant (company directory).
# Leave unset to allow any Microsoft/Azure AD account to sign in.
NEXT_PUBLIC_MICROSOFT_TENANT_ID=your_azure_ad_tenant_id

# SMTP settings used to email ticket requesters on status updates
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notifications@lazem.sa
SMTP_PASSWORD=your_smtp_password
SMTP_FROM_NAME=Lazem IT Ticketing
SMTP_FROM_EMAIL=notifications@lazem.sa

# Optional: also send every ticket status-change email to this address (e.g. the admin)
ADMIN_NOTIFY_EMAIL=admin@lazem.sa
